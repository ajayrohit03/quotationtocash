# Supabase Postgres (Prisma). Prisma 7's config no longer supports a separate
# directUrl — use the direct (non-pooled, port 5432) connection string here.
# If you need PgBouncer for serverless runtime, run `prisma migrate` with a
# temporarily-swapped DATABASE_URL pointed at the direct connection instead.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Supabase Storage (business logo uploads)
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="business-logos"

# Clerk auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/onboarding"

# Resend (transactional email — document sending)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="QuotationToCash <documents@yourdomain.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
