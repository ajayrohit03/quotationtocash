// QuotationToCash — Prisma schema
//
// NOTES FOR IMPLEMENTERS:
// - Document.status and LineItem.gstRate/discountPct are validated in
//   application code (lib/documents/status.ts), not as DB-level enums —
//   quotation and invoice statuses are mutually exclusive vocabularies.
// - Every business-owned model carries businessId and must be queried
//   scoped to it (see lib/auth/* helpers). Never fetch by id alone.
// - Document.customerSnapshot / businessSnapshot freeze the data used to
//   render that document at creation time; never derive historical
//   documents from the live Customer/Business rows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BusinessRole {
  owner
  admin
  staff

  @@map("business_role")
}

// See docs/invitation-onboarding-design.md §2/§4 for the full lifecycle.
enum InvitationStatus {
  pending
  accepted
  revoked
  expired

  @@map("invitation_status")
}

enum DocumentType {
  quotation
  invoice
  proforma

  @@map("document_type")
}

// See lib/einvoice/buildIrpPayload.ts and Document.einvoiceStatus's own
// comment — scaffolding only, no real IRP call exists yet. "generated"
// covers a document with a live IRN; "cancelled" is reserved for a
// future real cancellation call (IRP allows cancelling an IRN within 24
// hours) and isn't set anywhere yet.
enum EinvoiceStatus {
  none
  pending
  generated
  cancelled

  @@map("einvoice_status")
}

// See docs/custom-fields-and-multicurrency-design.md §1a.
enum CustomFieldType {
  text
  number
  date

  @@map("custom_field_type")
}

enum CustomFieldScope {
  document
  lineItem

  @@map("custom_field_scope")
}

enum DocumentTemplate {
  classic
  modern
  minimal
  compact
  formal

  @@map("document_template")
}

// Logo/signature image display size — a business-level preference
// (see Business.logoSize/signatureSize below), frozen into
// businessSnapshot at document-save time same as the images
// themselves. "md" is the existing baseline rendered size in both
// document-render.tsx and document-pdf.tsx before this feature; sm/lg/
// xl scale relative to it (75%/133%/175% — see those files' own
// LOGO_SIZE_SCALE/SIGNATURE_SIZE_SCALE comments).
enum AssetSize {
  sm
  md
  lg
  xl

  @@map("asset_size")
}

model Business {
  id      String  @id @default(uuid())
  name    String
  // Auto-generated from name at creation, never a UI-editable field —
  // see docs/public-share-subdomains-design.md §1. Powers the public
  // share-link subdomain ({slug}.{apex domain}), nothing else.
  slug    String  @unique
  email   String
  phone   String?
  address String?
  city    String?
  state   String?
  country String?
  website String?
  logoUrl String? @map("logo_url")

  // Authorised-signatory block shown at the bottom of every document —
  // see lib/documents/snapshots.ts's BusinessSnapshot (frozen at save
  // time, same as logoUrl) and Document.showSignature below (per-document
  // toggle). signatureImageUrl follows the exact same Supabase Storage
  // pattern as logoUrl (app/api/business/signature/route.ts,
  // lib/storage/signature.ts); name/designation are plain text, shown
  // even when no image is uploaded.
  signatureImageUrl      String? @map("signature_image_url")
  signatureSignatoryName String? @map("signature_signatory_name")
  signatureDesignation   String? @map("signature_designation")

  // Display size for the logo/signature images — Settings > Business
  // profile, a 4-step slider next to each image's own upload controls.
  // Business-level, not per-document (same tier as the images
  // themselves); frozen into businessSnapshot at save time, so a size
  // change here never retroactively resizes an already-sent document —
  // see lib/documents/snapshots.ts's BusinessSnapshot.
  logoSize      AssetSize @default(md) @map("logo_size")
  signatureSize AssetSize @default(md) @map("signature_size")

  gstEnabled       Boolean  @default(false) @map("gst_enabled")
  gstin            String?
  gstDefaultRate   Decimal? @map("gst_default_rate") @db.Decimal(5, 2)
  placeOfSupply    String?  @map("place_of_supply")
  registrationType String?  @map("registration_type")

  // Business-identity registration numbers — same tier as gstin above
  // (owner-only route, see app/api/business/identity/route.ts),
  // independent of gstEnabled: a business can have these without GST
  // being on. All optional; never required to create or send a document.
  pan       String?
  tan       String?
  cin       String?
  swiftCode String? @map("swift_code")

  // Bank/payment details shown in documents' PAYMENT DETAILS block — all
  // optional, same "financial weight" tier as GST (owner-only route, see
  // app/api/business/payment-details/route.ts), never required to create
  // or send a document. accountHolderName falls back to `name` at render
  // time when blank (see document-render.tsx/document-pdf.tsx), not
  // stored redundantly here.
  bankName          String?
  accountHolderName String? @map("account_holder_name")
  accountNumber     String? @map("account_number")
  ifscCode          String? @map("ifsc_code")
  upiId             String? @map("upi_id")

  documentTemplate DocumentTemplate @default(classic) @map("document_template")
  accentColor      String           @default("#4F46E5") @map("accent_color")

  // E-invoicing (IRP/GST) scaffolding — see docs on lib/einvoice/. No API
  // call is made anywhere yet (that's a follow-up session once the
  // client has real credentials); this is only storage + the "Generate
  // IRN" UI placeholder + the JSON payload builder. Owner-only route
  // (app/api/business/einvoicing/route.ts), same tier as gstin/tax
  // fields above. Independent of gstEnabled — e-invoicing is its own
  // opt-in, not implied by GST being on.
  einvoicingEnabled Boolean @default(false) @map("einvoicing_enabled")
  // Credentials from einvoice1.gst.gov.in — never required to create or
  // send a document; only consulted by the (future) IRN-generation call
  // and by the "Generate IRN" button's own enabled/disabled state.
  irpClientId       String? @map("irp_client_id")
  irpClientSecret   String? @map("irp_client_secret")
  irpUsername       String? @map("irp_username")
  // The GSTIN registered for e-invoicing — kept separate from the
  // business's own `gstin` above since IRP registration can, in edge
  // cases, be under a different GSTIN than the one on the document
  // header (e.g. a business with multiple registrations).
  irpGstin          String? @map("irp_gstin")

  // Pre-fill defaults for new documents (Settings > Documents) — never
  // applied retroactively to documents that already exist.
  defaultPaymentTerms  String? @map("default_payment_terms")
  defaultValidityTerms String? @map("default_validity_terms")
  defaultNotes         String? @map("default_notes")
  defaultTermsText     String? @map("default_terms_text")

  onboardingCompletedAt DateTime? @map("onboarding_completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members                BusinessMember[]
  customers              Customer[]
  vendors                Vendor[]
  products               Product[]
  documents              Document[]
  purchaseInvoices       PurchaseInvoice[]
  documentCounters       DocumentCounter[]
  invitations            Invitation[]
  customFieldDefinitions CustomFieldDefinition[]

  @@map("businesses")
}

model User {
  id             String  @id @default(uuid())
  email          String  @unique
  name           String?
  avatarUrl      String? @map("avatar_url")
  authProviderId String  @unique @map("auth_provider_id")

  // Keys of first-time-user guidance banners this user has dismissed
  // (e.g. "dashboard", "quotations") — tied to the user, not
  // BusinessMember, since it's about having seen the product's UI, not
  // something that should differ per business a user belongs to.
  dismissedTutorials String[] @default([]) @map("dismissed_tutorials")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships             BusinessMember[]
  // Historical attribution only — never used to resolve a User's current
  // hierarchy position (that's per-business, on BusinessMember). SetNull
  // on delete so a User row disappearing never breaks a document.
  createdDocuments        Document[]
  // Historical attribution only, same rationale as createdDocuments above.
  recordedPayments        Payment[]
  // Historical attribution only, same rationale as createdDocuments above.
  createdPurchaseInvoices PurchaseInvoice[]
  // Historical attribution only, same rationale as createdDocuments above.
  recordedVendorPayments  VendorPayment[]

  // Historical attribution only, same rationale as createdDocuments above
  // — see docs/invitation-onboarding-design.md §2.
  invitationsSent     Invitation[] @relation("InvitationsSent")
  invitationsAccepted Invitation[] @relation("InvitationsAccepted")

  @@map("users")
}

model BusinessMember {
  id         String       @id @default(uuid())
  businessId String       @map("business_id")
  userId     String       @map("user_id")
  role       BusinessRole @default(staff)

  // Document-visibility hierarchy — orthogonal to `role` (see
  // docs/hierarchy-access-control-design.md §7, Fork B Option A, and
  // docs/invitation-onboarding-design.md §1.3 for how `admin` extends
  // it). `role` keeps its own meaning: owner and admin both see every
  // document unconditionally (only owner reaches Tax/Billing settings,
  // see requireBusinessOwner() vs requireBusinessAdmin());
  // reportsToId/title/isActive govern hierarchy-based document
  // visibility among staff only.
  reportsToId String? @map("reports_to_id")
  // Free text, display-only — never read by authorization logic (§0 of
  // the design doc: access is a function of tree position, not title).
  title       String?
  // Soft-delete for departing members: revokes their own access
  // immediately (checked in requireBusiness()) without touching their
  // reportsToId, their direct reports' reportsToId, or any document's
  // createdByUserId — see design doc §5.
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Restrict, not Cascade/SetNull: a member with direct reports can't be
  // hard-deleted until those reports are explicitly reassigned — see
  // design doc §1 and §5. Deactivation (isActive), not deletion, is the
  // normal offboarding path.
  reportsTo     BusinessMember?  @relation("ReportsTo", fields: [reportsToId], references: [id], onDelete: Restrict)
  directReports BusinessMember[] @relation("ReportsTo")

  // Pending invitations that pre-fill this member as the new hire's
  // manager — see Invitation.reportsTo above.
  invitationsAsManager Invitation[]

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId, reportsToId])
  @@map("business_members")
}

model Customer {
  id         String @id @default(uuid())
  businessId String @map("business_id")

  name    String
  company String?
  email   String?
  phone   String?
  address String?
  city    String?
  state   String?
  gstin   String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([businessId])
  @@map("customers")
}

// See docs/accounts-payable-phase1-design.md §1.1. Separate from
// Customer — a vendor is who bills us, needs its own bank details/PAN/
// CIN, and must never contaminate Customer's queries with a role
// discriminator (design doc's own reasoning after that section's
// prisma block).
model Vendor {
  id         String @id @default(uuid())
  businessId String @map("business_id")

  name    String
  email   String?
  phone   String?
  address String?
  city    String?
  state   String?
  gstin   String?

  pan String?
  cin String?

  // Bank details of the VENDOR — who Accounts Payable owes money to,
  // same shape as Business's own bank fields for the identical reason
  // (design doc §1.1).
  bankName          String? @map("bank_name")
  accountHolderName String? @map("account_holder_name")
  accountNumber     String? @map("account_number")
  ifscCode          String? @map("ifsc_code")
  upiId             String? @map("upi_id")
  swiftCode         String? @map("swift_code")

  // Soft-delete — a Vendor referenced by a PurchaseInvoice can't be
  // hard-deleted (onDelete: Restrict on that FK, once it exists in
  // Stage b), same rationale as BusinessMember.isActive.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseInvoices PurchaseInvoice[]

  @@index([businessId])
  @@map("vendors")
}

// See docs/accounts-payable-phase1-design.md §2.
enum PurchaseInvoiceStatus {
  received
  approved
  partially_paid
  paid
  cancelled

  @@map("purchase_invoice_status")
}

// See docs/accounts-payable-phase1-design.md §1.2.
model PurchaseInvoice {
  id         String @id @default(uuid())
  businessId String @map("business_id")
  vendorId   String @map("vendor_id")

  // The vendor's OWN invoice number — never generated by us. Deliberately
  // NOT unique per business (design doc §1.2's own reasoning).
  vendorInvoiceNumber String    @map("vendor_invoice_number")
  vendorInvoiceDate   DateTime  @map("vendor_invoice_date")
  dueDate             DateTime? @map("due_date")

  status PurchaseInvoiceStatus @default(received)

  subtotal      Decimal @default(0) @db.Decimal(12, 2)
  taxableAmount Decimal @default(0) @map("taxable_amount") @db.Decimal(12, 2)
  cgst          Decimal @default(0) @db.Decimal(12, 2)
  sgst          Decimal @default(0) @db.Decimal(12, 2)
  igst          Decimal @default(0) @db.Decimal(12, 2)
  cess          Decimal @default(0) @db.Decimal(12, 2)
  total         Decimal @default(0) @db.Decimal(12, 2)
  currency      String  @default("INR")

  roundTotal         Boolean @default(false) @map("round_total")
  roundingAdjustment Decimal @default(0) @map("rounding_adjustment") @db.Decimal(12, 2)

  // Only meaningful when currency !== "INR" — see design doc §1.2.
  exchangeRate Decimal? @map("exchange_rate") @db.Decimal(12, 6)

  // Maintained running total, same pattern as Document.amountPaid — see
  // design doc §7. Written only inside the same transaction as every
  // VendorPayment insert/delete (Stage c); never live-summed on read.
  amountPaid Decimal @default(0) @map("amount_paid") @db.Decimal(12, 2)

  // Shipment/freight details — see design doc §1.4 for the full field
  // inventory and why these are typed columns rather than
  // CustomFieldDefinition entries.
  shipmentMode     String?   @map("shipment_mode")
  vesselVoyage     String?   @map("vessel_voyage")
  sailedDate       DateTime? @map("sailed_date")
  portOfLoading    String?   @map("port_of_loading")
  portOfDischarge  String?   @map("port_of_discharge")
  originPort       String?   @map("origin_port")
  placeOfDelivery  String?   @map("place_of_delivery")
  shipper          String?
  ciReference      String?   @map("ci_reference")
  salesPerson      String?   @map("sales_person")
  containerNo      String?   @map("container_no")
  jobRef           String?   @map("job_ref")
  customerRef      String?   @map("customer_ref")
  packageType      String?   @map("package_type")
  noOfPackages     Decimal?  @map("no_of_packages") @db.Decimal(12, 2)
  hbl              String?
  mbl              String?
  weightKg         Decimal?  @map("weight_kg") @db.Decimal(12, 2)
  chargeableWeight Decimal?  @map("chargeable_weight") @db.Decimal(12, 2)
  volumeCbm        Decimal?  @map("volume_cbm") @db.Decimal(12, 2)
  customsDocRef    String?   @map("customs_doc_ref")
  termsOfShipment  String?   @map("terms_of_shipment")

  notes String?

  // Frozen at save time — same non-negotiable rule as
  // Document.customerSnapshot/businessSnapshot. vendorSnapshot is the
  // new counterpart to customerSnapshot; businessSnapshot reuses the
  // exact same BusinessSnapshot type from lib/documents/snapshots.ts.
  vendorSnapshot   Json @map("vendor_snapshot")
  businessSnapshot Json @map("business_snapshot")

  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  vendor    Vendor             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  createdBy User?              @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  lineItems PurchaseLineItem[]
  payments  VendorPayment[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, vendorId])
  @@index([businessId, createdAt])
  @@map("purchase_invoices")
}

// See docs/accounts-payable-phase1-design.md §1.3.
model PurchaseLineItem {
  id                String @id @default(uuid())
  purchaseInvoiceId String @map("purchase_invoice_id")

  description String
  // SAC (Services Accounting Code) — see design doc §1.3.
  sac         String?

  qty  Decimal @db.Decimal(12, 2)
  unit String?

  rate   Decimal @db.Decimal(12, 2)
  amount Decimal @db.Decimal(12, 2)

  // Only meaningful when PurchaseInvoice.currency !== "INR" — see design
  // doc §1.3.
  amountInr Decimal? @map("amount_inr") @db.Decimal(12, 2)

  // Per-line foreign-currency provenance — mirrors LineItem's own
  // foreignCurrency/foreignRate/exchangeRate fields (schema.prisma's
  // comment on those): pure provenance/display, never read by the tax
  // engine or by `amount`/`taxableAmount`/`amountInr` above, which stay
  // the single values calculatePurchaseLineTotals ever computes from.
  // Lets a single invoice's line items each carry their own FC rate/
  // currency/exchange-rate/converted-amount for display (the reference
  // PDF's own "Currency", "Ex. Rate", "Invoice Amount (FC)" columns),
  // independent of — and in addition to — PurchaseInvoice's own
  // invoice-level currency/exchangeRate.
  rateFC     Decimal? @map("rate_fc") @db.Decimal(12, 2)
  exRate     Decimal? @map("ex_rate") @db.Decimal(12, 6)
  fcCurrency String?  @map("fc_currency")
  amountFC   Decimal? @map("amount_fc") @db.Decimal(12, 2)

  taxableAmount Decimal  @map("taxable_amount") @db.Decimal(12, 2)
  gstRate       Decimal? @map("gst_rate") @db.Decimal(5, 2)
  cgst          Decimal  @default(0) @db.Decimal(12, 2)
  sgst          Decimal  @default(0) @db.Decimal(12, 2)
  igst          Decimal  @default(0) @db.Decimal(12, 2)
  cess          Decimal  @default(0) @db.Decimal(12, 2)

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)

  @@index([purchaseInvoiceId])
  @@map("purchase_line_items")
}

// See docs/accounts-payable-phase1-design.md §1.5/§7. Field-for-field
// identical shape to Payment (deliberately — same audit-trail
// reasoning), just its own table and its own FK target: a nullable
// polymorphic invoiceId/purchaseInvoiceId pair on one shared table
// would invite a row with both or neither set, and Payment.amount
// (received) vs this.amount (paid out) are semantically opposite
// directions, not just a label swap. PurchaseInvoice.amountPaid is the
// maintained running total kept in sync with this table in the same
// transaction as every insert/delete here — same "frozen, not
// live-recomputed" shape as Payment/Document.amountPaid.
model VendorPayment {
  id                String   @id @default(uuid())
  purchaseInvoiceId String   @map("purchase_invoice_id")
  amount            Decimal  @db.Decimal(12, 2)
  method            String?
  paidAt            DateTime @map("paid_at")
  note              String?

  // Null for backfilled/pre-tracking rows — never backfilled with a
  // guessed user, onDelete: SetNull like every other historical-
  // attribution field so a removed user doesn't take payment history
  // down with them.
  recordedByUserId String? @map("recorded_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  recordedBy      User?           @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([purchaseInvoiceId, paidAt])
  @@map("vendor_payments")
}

model Product {
  id         String @id @default(uuid())
  businessId String @map("business_id")

  name        String
  description String?
  sku         String?
  unit        String?
  price       Decimal  @db.Decimal(12, 2)
  gstRate     Decimal? @map("gst_rate") @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lineItems LineItem[]

  @@index([businessId])
  @@map("products")
}

model Document {
  id         String       @id @default(uuid())
  businessId String       @map("business_id")
  type       DocumentType

  number     String
  customerId String @map("customer_id")

  issueDate     DateTime  @map("issue_date")
  dueDate       DateTime? @map("due_date")
  validUntil    DateTime? @map("valid_until")
  paymentTerms  String?   @map("payment_terms")
  validityTerms String?   @map("validity_terms")

  // String, not a DB enum — validated against QUOTATION_STATUSES /
  // INVOICE_STATUSES in lib/documents/status.ts based on `type`.
  status String @default("draft")

  subtotal      Decimal @default(0) @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxableAmount Decimal @default(0) @map("taxable_amount") @db.Decimal(12, 2)
  cgst          Decimal @default(0) @db.Decimal(12, 2)
  sgst          Decimal @default(0) @db.Decimal(12, 2)
  igst          Decimal @default(0) @db.Decimal(12, 2)
  total         Decimal @default(0) @db.Decimal(12, 2)
  currency      String  @default("INR")

  // "Round total" (Customize sidebar, SHOW ON DOCUMENT — see
  // appearanceUpdateSchema/document-preview.tsx) rounds `total` to the
  // nearest whole currency unit. roundTotal is the toggle; roundingAdjustment
  // is the resulting delta (Math.round(rawTotal) - rawTotal, so negative
  // when rounding down), persisted the same way discountTotal is — a real
  // stored column, computed once server-side in PATCH
  // /api/documents/:id (see lib/tax/applyRounding.ts) and never trusted
  // from the client. `total` above already reflects the rounded figure
  // when roundTotal is on: it's what remainingBalance/payments compare
  // against, so the amount actually invoiced must be the amount actually
  // collectable. The web/PDF renderers don't read roundingAdjustment
  // directly — they recompute the "Rounding" line and GRAND TOTAL live
  // from taxableAmount+cgst+sgst+igst plus the *current* toggle state
  // (same applyRounding call), so flipping the switch in the Customize
  // sidebar updates the total instantly, before the debounced autosave
  // PATCH lands — same "live preview" guarantee every other appearance
  // toggle already has.
  roundTotal         Boolean @default(false) @map("round_total")
  roundingAdjustment Decimal @default(0) @map("rounding_adjustment") @db.Decimal(12, 2)

  // Foreign-currency invoicing (Document's own settlement currency, not
  // the per-line-item FX helper below on LineItem) — see
  // docs/foreign-currency-invoicing-design.md. showInrEquivalent/
  // inrExchangeRate are purely a display add-on: an optional INR
  // sub-line under Subtotal/Grand Total, computed client-side as
  // amount × inrExchangeRate — never touches the tax engine or the
  // persisted totals above, same "provenance only" rule as LineItem's
  // foreignRate/exchangeRate.
  showInrEquivalent Boolean  @default(false) @map("show_inr_equivalent")
  inrExchangeRate   Decimal? @map("inr_exchange_rate") @db.Decimal(12, 6)

  // Standard GST export/LUT declaration wording, shown in the footer
  // only when currency isn't INR — pre-populated via the @default below
  // so every document already has editable text the moment its currency
  // is changed, same "editable default, not hardcoded" rule as
  // termsText.
  lutDeclarationText String? @default("Supply meant for export under Letter of Undertaking (LUT) without payment of Integrated Tax.") @map("lut_declaration_text")

  // Maintained running total of this invoice's Payment rows — updated
  // transactionally alongside every payment create/reverse, never
  // live-summed from `payments` on read. See
  // docs/payment-tracking-design.md §1. Quotations never have payments;
  // stays 0 for them.
  amountPaid Decimal @default(0) @map("amount_paid") @db.Decimal(12, 2)

  template    DocumentTemplate @default(classic)
  accentColor String           @default("#4F46E5") @map("accent_color")
  // Base font size in points, 7-12 — null means "use the template's own
  // default" (no visual change from today). A user-controlled escape
  // hatch for documents with many columns/long text that don't fit the
  // default sizing — see docs/pdf-layout-fixes-design.md. Same
  // autosave-on-Customize-sidebar pattern as template/accentColor,
  // consumed identically by the web preview (as a CSS scale factor) and
  // the PDF renderer (direct per-Text fontSize multiplication).
  fontSize    Int?             @map("font_size")

  // Logo/signature display size — real per-document fields, same tier
  // as template/accentColor/fontSize above, NOT frozen inside
  // businessSnapshot the way they originally were. Two problems with
  // the snapshot approach: (a) a document created before this feature
  // shipped had no size keys in its snapshot at all, and could only
  // pick one up by being re-saved — silently broken for every
  // pre-existing draft, permanently stuck for anything already sent;
  // (b) logo/signature size is a pure presentation preference, not
  // compliance data like GSTIN/address/bank details — there's no legal
  // reason freezing it at save time was ever the right call, unlike
  // those fields. @default(md) means the migration that added these
  // columns backfilled every existing row (drafts and already-sent
  // documents alike) with a real value immediately — no re-save
  // needed. New documents get the business's current preference copied
  // in at creation time (POST /api/documents, same as template/
  // accentColor); from then on this is this document's own field,
  // editable via the normal appearance-update flow while still a draft
  // (appearanceUpdateSchema), and signatureSize additionally stays
  // adjustable after send via POST/PATCH .../update-signature (the same
  // narrow non-frozen exception that route already carved out — see
  // its own comment).
  logoSize      AssetSize @default(md) @map("logo_size")
  signatureSize AssetSize @default(md) @map("signature_size")

  // E-invoicing (IRP/GST) — scaffolding only, no API call made anywhere
  // yet (see Business.einvoicingEnabled's own comment). irn is the
  // 64-char Invoice Reference Number IRP returns once generation is
  // real; ackNo/ackDate and the QR code string are stored verbatim as
  // IRP returns them (ackDate as their own String format, not a real
  // DateTime — never parsed/recomputed here). einvoiceStatus is the
  // single source of truth for which UI state to show (see
  // document-preview.tsx's "Generate IRN" button and
  // document-render.tsx/document-pdf.tsx's IRN/QR block) — not derived
  // from whether `irn` happens to be set, so a future "cancelled" state
  // (irn still present, but no longer valid) has somewhere to live.
  einvoiceStatus EinvoiceStatus @default(none) @map("einvoice_status")
  irn            String?        @map("irn")
  irnGeneratedAt DateTime?      @map("irn_generated_at")
  irnAckNo       String?        @map("irn_ack_no")
  irnAckDate     String?        @map("irn_ack_date")
  einvoiceQrCode String?        @map("einvoice_qr_code")

  showLogo            Boolean @default(true) @map("show_logo")
  showGstinRow        Boolean @default(true) @map("show_gstin_row")
  showTax             Boolean @default(true) @map("show_tax")
  showDiscount        Boolean @default(true) @map("show_discount")
  showPayment         Boolean @default(true) @map("show_payment")
  showNotes           Boolean @default(true) @map("show_notes")
  showTerms           Boolean @default(true) @map("show_terms")
  showReferenceNumber Boolean @default(false) @map("show_reference_number")
  showSignature       Boolean @default(true) @map("show_signature")

  notes           String?
  termsText       String? @map("terms_text")
  referenceNumber String? @map("reference_number")

  // Frozen copies of the business/customer data used to render this
  // document — must never be re-derived from the live rows.
  customerSnapshot Json @map("customer_snapshot")
  businessSnapshot Json @map("business_snapshot")

  // Document-scope custom field values, snapshotting both value AND
  // definition metadata (label/type/sortOrder) as of save time — see
  // docs/custom-fields-and-multicurrency-design.md §1a. Never re-derived
  // from the live CustomFieldDefinition row: a later rename or archive
  // must never touch a document that already recorded a value here.
  // Array<CustomFieldValueSnapshot>, see lib/documents/custom-fields.ts.
  customFieldValues Json @default("[]") @map("custom_field_values")

  convertedFromQuotationId String?   @unique @map("converted_from_quotation_id")
  convertedFromQuotation   Document? @relation("QuotationConversion", fields: [convertedFromQuotationId], references: [id])
  convertedToInvoice       Document? @relation("QuotationConversion")

  shareToken String?   @unique @map("share_token")
  sentAt     DateTime? @map("sent_at")
  viewedAt   DateTime? @map("viewed_at")

  // Hierarchy-based visibility key. NULL means "created before this
  // feature existed" and is deliberately never backfilled — see
  // docs/hierarchy-access-control-design.md §3. Every document created
  // from this feature onward always has this set at creation time.
  createdByUserId String? @map("created_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User?      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  lineItems LineItem[]
  payments  Payment[]

  @@unique([businessId, number])
  @@index([businessId])
  @@index([businessId, type])
  @@index([businessId, status])
  @@index([businessId, customerId])
  @@index([businessId, createdByUserId])
  // Covers the list/dashboard pages' `orderBy: { createdAt: "desc" }` —
  // without createdAt in the index, Postgres can use (businessId, type)
  // to filter but must still sort the full matching set afterward.
  @@index([businessId, type, createdAt])
  @@map("documents")
}

model LineItem {
  id         String  @id @default(uuid())
  documentId String  @map("document_id")
  productId  String? @map("product_id")

  name        String
  description String?
  qty         Decimal  @db.Decimal(12, 2)
  // In Document.currency, always — the single value calculateDocumentTotals
  // / calculateGST read. See docs/custom-fields-and-multicurrency-design.md
  // §1b/§2: when foreignCurrency is set, this is *derived* once at entry
  // time (round(foreignRate × exchangeRate, 2)) and then behaves as an
  // ordinary editable field, same as always — the tax engine has zero
  // awareness of the three fields below.
  rate        Decimal  @db.Decimal(12, 2)
  discountPct Decimal  @default(0) @map("discount_pct") @db.Decimal(5, 2)
  gstRate     Decimal? @map("gst_rate") @db.Decimal(5, 2)
  amount      Decimal  @db.Decimal(12, 2)
  sortOrder   Int      @default(0) @map("sort_order")

  // Pure provenance/display — never read by any calculation function.
  // Deleting them wouldn't change a single total. exchangeRate carries
  // more precision than `rate` itself (6 vs 2 decimal places) since real
  // INR exchange rates commonly need 4-6 significant digits.
  foreignCurrency String?  @map("foreign_currency")
  foreignRate     Decimal? @map("foreign_rate") @db.Decimal(12, 2)
  exchangeRate    Decimal? @map("exchange_rate") @db.Decimal(12, 6)

  // Line-item-scope custom field values — same snapshot shape and same
  // freeze-at-save reasoning as Document.customFieldValues (see that
  // field's comment). Array<CustomFieldValueSnapshot>, see
  // lib/documents/custom-fields.ts.
  customFieldValues Json @default("[]") @map("custom_field_values")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@map("line_items")
}

// Backs concurrency-safe document numbering (lib/documents/numbering.ts).
// One row per (business, document type, year); lastNumber is incremented
// atomically via Prisma upsert, which compiles to a native Postgres
// INSERT ... ON CONFLICT DO UPDATE — no read-then-write race window.
model DocumentCounter {
  id         String       @id @default(uuid())
  businessId String       @map("business_id")
  type       DocumentType
  year       Int
  lastNumber Int          @default(0) @map("last_number")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, type, year])
  @@map("document_counters")
}

// See docs/custom-fields-and-multicurrency-design.md §1a. The
// management/structural side — CRUD in Settings. Never referenced live
// by a saved document: every Document/LineItem freezes a snapshot of
// {definitionId, label, type, value, sortOrder} at save time (its own
// customFieldValues Json column), so renaming or archiving a definition
// here never touches a document that already used it.
model CustomFieldDefinition {
  id         String           @id @default(uuid())
  businessId String           @map("business_id")
  label      String
  type       CustomFieldType
  scope      CustomFieldScope
  // Null = applies to both quotations and invoices.
  appliesTo  DocumentType?    @map("applies_to")
  sortOrder  Int              @default(0) @map("sort_order")
  // Soft-delete only — same rationale as BusinessMember.isActive.
  isActive   Boolean          @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, scope])
  @@map("custom_field_definitions")
}

// See docs/payment-tracking-design.md. The auditable ledger — one row
// per real transaction, including backfilled rows from that doc's §4
// migration (recordedByUserId null, note explaining the approximation).
// Document.amountPaid is a maintained running total kept in sync with
// this table in the same transaction as every insert/delete here —
// same "frozen, not live-recomputed" shape as Document.total itself.
model Payment {
  id        String   @id @default(uuid())
  invoiceId String   @map("invoice_id")
  amount    Decimal  @db.Decimal(12, 2)
  method    String?
  paidAt    DateTime @map("paid_at")
  note      String?

  // Null for backfilled/pre-tracking rows (see design doc §4) — never
  // backfilled with a guessed user, onDelete: SetNull like
  // Document.createdByUserId so a removed user doesn't take payment
  // history down with them.
  recordedByUserId String? @map("recorded_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")

  invoice    Document @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User?    @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([invoiceId, paidAt])
  @@map("payments")
}

// See docs/invitation-onboarding-design.md for the full design. A person
// joins a business by accepting one of these, never by "add member by
// email" (that mechanism is being retired in the same change that adds
// this table).
model Invitation {
  id         String @id @default(uuid())
  businessId String @map("business_id")

  // Stored as provided; every comparison against it is case-insensitive
  // (creation dedup, accept-time email match) rather than normalized at
  // write time.
  email String

  // Never "owner" — there is exactly one Owner, set at business
  // creation; enforced in the create-invitation handler, not here.
  role BusinessRole @default(staff)

  // Pre-fills the new member's hierarchy position; no cycle check is
  // needed at this stage since the invitee isn't a tree node yet — see
  // design doc §4.1. SetNull, not Restrict: BusinessMember rows are never
  // hard-deleted in practice (isActive is the offboarding path), but if
  // one ever were, a stale reference here shouldn't block it.
  title       String?
  reportsToId String?         @map("reports_to_id")
  reportsTo   BusinessMember? @relation(fields: [reportsToId], references: [id], onDelete: SetNull)

  // SHA-256 of the raw token — the raw value is never persisted, same
  // standard as a password-reset token. See design doc §3.
  tokenHash String @unique @map("token_hash")

  status InvitationStatus @default(pending)

  invitedByUserId  String  @map("invited_by_user_id")
  acceptedByUserId String? @map("accepted_by_user_id")

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy  User     @relation("InvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  acceptedBy User?    @relation("InvitationsAccepted", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([email])
  @@map("invitations")
}

// Postgres-backed fixed-window rate limiting (design doc §6.2) — this app
// has no Redis/cache layer, so an in-memory counter wouldn't survive a
// multi-instance deployment. bucketKey encodes both the dimension and the
// identity being limited (e.g. "invite:user:<id>", "invite:email:<addr>",
// "invite-accept:ip:<addr>"); windowStart is the fixed-window floor, so
// (bucketKey, windowStart) is naturally the unit to upsert-increment
// atomically via Postgres's native INSERT ... ON CONFLICT.
model RateLimitHit {
  id          String   @id @default(uuid())
  bucketKey   String   @map("bucket_key")
  windowStart DateTime @map("window_start")
  count       Int      @default(1)

  @@unique([bucketKey, windowStart])
  @@map("rate_limit_hits")
}
